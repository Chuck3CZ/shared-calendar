CLOUDFLARE_TUNNEL_TOKEN=
ADMIN_BOOTSTRAP_SECRET=
APPLE_BUNDLE_ID=cz.gabrhelovi.sharedcalendar
APNS_KEY_ID=
APNS_TEAM_ID=
# false while running the app straight from Xcode to a device (sandbox
# APNs); true only once distributed via TestFlight/App Store.
APNS_PRODUCTION=false
# Optional: fine-grained PAT with "Issues: read and write" on the repo below.
# Without these two set, bug reports still work, they just stay app-only.
GITHUB_TOKEN=
GITHUB_REPO=Chuck3CZ/shared-calendar
# Optional: a Keys → WeatherKit key (separate from the app's own on-device
# WeatherKit access). Without these two set, events just show no forecast —
# the app no longer calls WeatherKit itself.
WEATHERKIT_KEY_ID=
WEATHERKIT_KEY_PATH=/secrets/weatherkit_key.p8
